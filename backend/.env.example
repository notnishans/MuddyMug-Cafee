# Copy this file to .env and fill in real values for your local machine.
# .env is gitignored — never commit real secrets.

# Server
PORT=4000
NODE_ENV=development

# Frontend origin allowed to call this API.
# Will be enforced once CORS is restricted (security-hardening issue).
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string.
# Required once the database layer is wired in (Issue #4).
MONGODB_URI=

# JWT signing secret for admin authentication.
# Required once admin auth is wired in (Issue #6). Use a long random string.
JWT_SECRET=
JWT_EXPIRY=7d
